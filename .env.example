# 이 파일을 복사해서 같은 폴더에 ".env" 파일을 만들고 값을 채우세요.
# 실제 값은 팀 단톡방에서 받습니다. .env 파일은 GitHub에 올라가지 않습니다.

# Supabase: 대시보드 Project Settings → API Keys의 Publishable key (sb_publishable_...). secret 키는 절대 넣지 않는다
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 가짜 데이터 모드. false로 바꾸면 Supabase로 바꾼 api 함수(src/api/README.md 참고)가 실제 서버를 쓴다
EXPO_PUBLIC_USE_MOCK_API=true

# 네이버 지도 (S09 혼자 화면)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
